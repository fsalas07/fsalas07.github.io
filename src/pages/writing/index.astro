---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDayMonth, isoDate, postUrl, type Post } from '../../lib/posts';

const posts = await getPosts();
const byYear = new Map<number, Post[]>();
for (const p of posts) {
  const y = p.data.date.getUTCFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---
<Base title="Writing" description="Essays and notes by Fabian Salas.">
  <div class="prose">
    <h1 class="page-title">Writing</h1>
    {years.length === 0 && <p class="muted">Nothing published yet.</p>}
    {years.map(([year, items]) => (
      <section>
        <h2 class="year-heading">{year}</h2>
        <ul class="post-list">
          {items.map((p) => (
            <li>
              <time class="post-date" datetime={isoDate(p.data.date)}>{formatDayMonth(p.data.date)}</time>
              <a href={postUrl(p)} data-list-item>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
