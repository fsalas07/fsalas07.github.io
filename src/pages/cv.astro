---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---
<Base title="CV" description="Curriculum vitae of Fabian Salas.">
  <article class="prose cv">
    <div class="cv-top">
      <h1>{SITE.name}</h1>
      <p class="cv-print-hint no-print">
        <button type="button" class="print-button" data-print>print / save as PDF</button>
      </p>
    </div>
    <p class="cv-contact">
      Paterson, NJ ·
      <a href="mailto:fabiansalas1233@gmail.com">fabiansalas1233@gmail.com</a> ·
      <a href="https://www.linkedin.com/in/fabiansalas2007" rel="me">linkedin.com/in/fabiansalas2007</a> ·
      <a href={SITE.github} rel="me">github.com/fsalas07</a>
    </p>

    <section>
      <h2>Education</h2>
      <div class="cv-entry">
        <h3>A.S., Physical Science, Passaic County Community College</h3>
        <span class="cv-when">Paterson, NJ · Present</span>
        <p>Coursework: Calculus 3, Engineering Statics and Dynamics, Accounting 101 &amp; 102.</p>
      </div>
      <div class="cv-entry">
        <h3>High School Diploma, Global Management, Passaic County Technical Institute</h3>
        <span class="cv-when">Wayne, NJ · June 2025</span>
        <p>GPA: 3.9. AP Calculus BC, AP Physics C: Mechanics.</p>
      </div>
    </section>

    <section>
      <h2>Experience</h2>
      <div class="cv-entry">
        <h3>Economic Development Intern, County of Passaic</h3>
        <span class="cv-when">Paterson, NJ · July 2026 – Present</span>
        <ul>
          <li>Parsed a database of every high-confidence business in New Jersey to analyze 100 corridors within Passaic County, ranking each using proprietary weighted measurements in Excel to identify high-potential corridors.</li>
          <li>Built a Python algorithm to generate a continuously updatable, accessible PDF directly from an Excel data source.</li>
        </ul>
      </div>
      <div class="cv-entry">
        <h3>Sales Intern, Verizon Small Business Digital Ready</h3>
        <span class="cv-when">Remote · April 2026 – June 2026</span>
        <ul>
          <li>Visited and consulted with over 25 small businesses to inform owners of the Digital Ready program and its resources.</li>
          <li>Converted 12 of 25 prospects (48%) into enrolled program participants through direct outreach and follow-up.</li>
        </ul>
      </div>
      <div class="cv-entry">
        <h3>Vice President, Student Government Association, Passaic County Community College</h3>
        <span class="cv-when">Paterson, NJ · July 2026 – Present</span>
        <ul>
          <li>Serve as second-in-command of the Executive Branch, assuming presidential duties and authority when the President is unavailable, while overseeing club governance and SGA financial operations.</li>
          <li>Chair the Club Activities &amp; Finance Committee, reviewing club registrations and directing fund allocation and financial reporting for all SGA-funded clubs.</li>
          <li>Maintain official financial records across all SGA-overseen budgets, tracking funds raised and disbursed across club accounts.</li>
        </ul>
      </div>
      <div class="cv-entry">
        <h3>Student Programming Committee Chair &amp; Senator, Passaic County Community College</h3>
        <span class="cv-when">Paterson, NJ · September 2025 – June 2026</span>
        <ul>
          <li>Oversaw a $28,000+ annual programming budget as a voting member of the Legislative Branch, planning and executing co-curricular events across three campuses (Paterson, Wanaque, Passaic).</li>
          <li>Directed logistics for signature SGA events (Welcome Week, Constitution Day, Involvement Fair, Thanksgiving Luncheon, End of Year Celebration), coordinating consistent execution across all three campuses.</li>
        </ul>
      </div>
      <div class="cv-entry">
        <h3>Research Intern, MOCORE Laboratory, Stevens Institute of Technology</h3>
        <span class="cv-when">Hoboken, NJ · July 2024 – January 2026</span>
        <ul>
          <li>Programmed and tested virtual reality applications for cognitive and physical rehabilitation under faculty mentorship.</li>
          <li>Contributed testing data and research results supporting the lab's NSF GameMaker grant application.</li>
        </ul>
      </div>
    </section>

    <section>
      <h2>Leadership &amp; Activities</h2>
      <div class="cv-entry">
        <h3>Editor-in-Chief, The Panther Vision</h3>
        <span class="cv-when">Clifton, NJ · May 2026 – Present</span>
        <ul>
          <li>Lead a team of editors covering campus news and student issues for the PCCC community.</li>
          <li>Built and maintain the publication's website hosting articles and newspaper information.</li>
        </ul>
      </div>
      <div class="cv-entry">
        <h3>AI &amp; Cybersecurity Program Participant, PROSPER Grant, New Mexico Institute of Mining and Technology</h3>
        <span class="cv-when">Socorro, NM · August 2026</span>
        <ul>
          <li>Built and trained neural networks in Google Colab in hands-on labs with doctoral students from Huixin Zhan's group.</li>
          <li>Collaborated to develop an AI application and tested it against cybersecurity attacks, including prompt injection.</li>
        </ul>
      </div>
    </section>

    <section>
      <h2>Skills &amp; Interests</h2>
      <dl class="cv-skills">
        <dt>Technical</dt><dd>Microsoft Excel, Google Sheets, Microsoft Office, Google Workspace, LaTeX, Canva, C#, Unity 3D</dd>
        <dt>Languages</dt><dd>Spanish (fluent), English (fluent)</dd>
        <dt>Interests</dt><dd>Physics, writing, martial arts (Judo, Brazilian Jiu-Jitsu)</dd>
        <dt>Awards</dt><dd>Second Place (2022) and Honorable Mention (2024), Peace Islands Institute Essay Contest ($500 total). Silver Medal, Inter-Club Judo Tournament, High Tech High School. AP Scholar.</dd>
      </dl>
    </section>
  </article>
</Base>
<script is:inline>
  document.querySelector('[data-print]').addEventListener('click', function () { window.print(); });
</script>
